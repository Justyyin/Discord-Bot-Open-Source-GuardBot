<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS autostart: copy to ~/Library/LaunchAgents/de.guardbot.plist, replace /Users/you/guardbot, then run: launchctl load ~/Library/LaunchAgents/de.guardbot.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.guardbot</string>
  <key>WorkingDirectory</key><string>/Users/you/guardbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/guardbot/.venv/bin/python</string>
    <string>main.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/you/guardbot/data/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/you/guardbot/data/stderr.log</string>
</dict>
</plist>
